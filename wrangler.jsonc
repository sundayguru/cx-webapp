{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rallyard",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB", // available in your Worker on env.DB
      "database_name": "test_stage_db",
      "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
      "migrations_dir": "./drizzle"
    }
  ],
  "env": {
    "production": {
      "name": "production-rallyard",
      "d1_databases": [
        {
          "binding": "DB", // available in your Worker on env.DB
          "database_name": "test_stage_db",
          "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
          "migrations_dir": "./drizzle"
        }
      ],
    },
    "dev": {
      "name": "dev-rallyard",
      "d1_databases": [
        {
          "binding": "DB", // available in your Worker on env.DB
          "database_name": "test_stage_db",
          "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
          "migrations_dir": "./drizzle"
        }
      ],
    }
  }
}