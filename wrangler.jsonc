{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rallyard",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test_stage_db",
      "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
      "migrations_dir": "./drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "COURSE_CONTENT",
      "bucket_name": "course-content",
    },
  ],
  "env": {
    "production": {
      "name": "production-rallyard",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "test_stage_db",
          "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "COURSE_CONTENT",
          "bucket_name": "course-content",
        },
      ],
    },
    "dev": {
      "name": "dev-rallyard",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "test_stage_db",
          "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "COURSE_CONTENT",
          "bucket_name": "course-content",
        },
      ],
    },
  },
}
