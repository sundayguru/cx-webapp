{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coursexquiz",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coursexquiz",
      "database_id": "3701850f-7fe1-4a1b-a1ef-3837e4870b33",
      "migrations_dir": "./drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "COURSE_CONTENT",
      "bucket_name": "coursexquiz",
    },
  ],
  "workflows": [
    {
      "binding": "COURSE_PROCESSING_WORKFLOW",
      "name": "course-processing-workflow",
      "class_name": "CourseProcessingWorkflow",
    },
    {
      "binding": "COURSE_UNIT_AUDIO_WORKFLOW",
      "name": "course-unit-audio-workflow",
      "class_name": "CourseUnitAudioWorkflow",
    },
  ],
  "routes": [
    {
      "pattern": "coursexquiz.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.coursexquiz.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BASE_URL": "https://coursexquiz.com",
  },
  "env": {
    "production": {
      "name": "prod-coursexquiz",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "coursexquiz",
          "database_id": "3701850f-7fe1-4a1b-a1ef-3837e4870b33",
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "COURSE_CONTENT",
          "bucket_name": "coursexquiz",
        },
      ],
      "workflows": [
        {
          "binding": "COURSE_PROCESSING_WORKFLOW",
          "name": "course-processing-workflow",
          "class_name": "CourseProcessingWorkflow",
        },
        {
          "binding": "COURSE_UNIT_AUDIO_WORKFLOW",
          "name": "course-unit-audio-workflow",
          "class_name": "CourseUnitAudioWorkflow",
        },
      ],
      "vars": {
        "BASE_URL": "https://coursexquiz.com",
      },
    },
    "dev": {
      "name": "dev-coursexquiz",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "test_stage_db",
          "database_id": "0504496b-6e16-4e44-aef5-50189a9c073e",
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "COURSE_CONTENT",
          "bucket_name": "coursexquiz",
        },
      ],
      "workflows": [
        {
          "binding": "COURSE_PROCESSING_WORKFLOW",
          "name": "course-processing-workflow",
          "class_name": "CourseProcessingWorkflow",
        },
        {
          "binding": "COURSE_UNIT_AUDIO_WORKFLOW",
          "name": "course-unit-audio-workflow",
          "class_name": "CourseUnitAudioWorkflow",
        },
      ],
      "vars": {
        "BASE_URL": "http://localhost:5173",
      },
    },
  },
}
